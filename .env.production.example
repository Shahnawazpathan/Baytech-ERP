# Production Environment Variables Template
# Copy this to .env.production and fill in your production values

# Database (Turso)
TURSO_DATABASE_URL=your_production_turso_database_url
TURSO_AUTH_TOKEN=your_production_turso_auth_token

# Next.js
NODE_ENV=production
PORT=3007

# Application
APP_URL=https://your-production-domain.com

# ── REQUIRED: Session security ──────────────────────────────────────────
# HMAC key for session cookies. Generate with: openssl rand -hex 32
# Must be at least 32 characters or the server refuses to boot.
SESSION_SECRET=generate_with_openssl_rand_hex_32

# ── REQUIRED on first deploy: Initial admin password ────────────────────
# Used only when creating admin@baytech.com for the first time.
# Generate a strong value; the credential is NOT stored in this repo.
ADMIN_INITIAL_PASSWORD=use_a_strong_unique_password_min_8_chars

# ── SMTP (password reset emails) ────────────────────────────────────────
SMTP_HOST=mail.your-domain.com
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_USER=info@your-domain.com
EMAIL_PASS=your_smtp_password

# Optional: Logging
LOG_LEVEL=error

# Optional: Redis (for distributed caching - future enhancement)
# REDIS_URL=redis://localhost:6379
